# 百度地图开放平台 服务端 AK（后端调 Web 服务 API 用）
BAIDU_MAP_AK=

# DeepSeek（地点结构化抽取）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 文字攻略 / 一句话规划的调用边界（非密钥）
PLANNER_TIMEOUT=60
PLANNER_ATTEMPTS=2
PLANNER_MAX_TOKENS=4096

# 百度浏览器地图 AK 由后端读取，勿写入前端产物
BAIDU_JSAPI_AK=

# 临时固定重庆演示：默认 true，阻止旧页面发起真实模型请求。
# 恢复真实模式还需 frontend 中 VITE_PRESET_DEMO=false npm run build。
PRESET_DEMO=true
